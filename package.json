{
  "name": "js-dependency-security",
  "version": "1.0.0",
  "description": "A CLI tool to detect known vulnerabilities in JavaScript dependencies.",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "keywords": [
    "security",
    "cybersecurity",
    "dependencies",
    "vulnerability",
    "npm",
    "devsecops"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
